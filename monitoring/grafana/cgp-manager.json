    {
      "id": 7,
      "title": "Local public certificate read status",
      "description": "Enabled domains, fresh local snapshot. Readable only means public cert.pem was parsed; expired leaves can be readable. Read errors remain visible on incomplete snapshots. This is not chain, private-key, hostname or served TLS validation.",
      "type": "table",
      "pluginVersion": "11.0.0",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 10,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(max without (status) ((cgp_manager_local_certificate_status{cgp_manager=\"true\",job=~\"${job:regex}\",instance=~\"${instance:regex}\",domain=~\"${domain:regex}\",status=\"ok\"} == 1) * 0 or (cgp_manager_local_certificate_status{cgp_manager=\"true\",job=~\"${job:regex}\",instance=~\"${instance:regex}\",domain=~\"${domain:regex}\",status=\"missing\"} == 1) * 1 or (cgp_manager_local_certificate_status{cgp_manager=\"true\",job=~\"${job:regex}\",instance=~\"${instance:regex}\",domain=~\"${domain:regex}\",status=\"error\"} == 1) * 2)) and on (job, instance) ((up{cgp_manager=\"true\",job=~\"${job:regex}\",instance=~\"${instance:regex}\"} == 1) and on (job, instance) ((time() - cgp_manager_collection_timestamp_seconds{cgp_manager=\"true\",job=~\"${job:regex}\",instance=~\"${instance:regex}\"}) >= 0) and on (job, instance) ((time() - cgp_manager_collection_timestamp_seconds{cgp_manager=\"true\",job=~\"${job:regex}\",instance=~\"${instance:regex}\"}) <= 900)) and on (job, instance, domain) (cgp_manager_domain_enabled{cgp_manager=\"true\",job=~\"${job:regex}\",instance=~\"${instance:regex}\",domain=~\"${domain:regex}\"} == 1)",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],

{
  "dns_provider": "route53",
  "dns_preflight": true,
  "dns_propagation": {
    "mode": "adaptive",
    "timeout_seconds": 300,
    "poll_interval_seconds": 5
  },
  "route53": {
    "zones": [
      {
        "zone": "example.com",
        "hosted_zone_id": "ZEXAMPLE123",
        "account_id": "123456789012",
        "credentials": "/etc/cgp-letsencrypt/route53.json",
        "nameservers": ["ns1.example.com", "ns2.example.com"]
      }
    ]
  }
}

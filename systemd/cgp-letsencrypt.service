[Unit]
Description=CGP Certificate Manager 2.0.1
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/cgp-letsencrypt
TimeoutStartSec=7200
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/letsencrypt /var/lib/cgp-letsencrypt
